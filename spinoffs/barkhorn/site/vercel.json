{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/s/colour-:name",
      "destination": "/s/color-:name",
      "permanent": true
    },
    {
      "source": "/s/journal-eight-colours",
      "destination": "/s/journal-eight-colors",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "r31-*": false,
      "r32-*": false,
      "claude/*": false
    }
  }
}